{
  "height": 30,
  "spacing": 0,
  "modules-left": ["sway/workspaces", "sway/window"],
  "modules-right": [
    "pulseaudio",
    "custom/separator",
    "network",
    "custom/separator",
    "battery",
    "custom/separator",
    "clock",
    "custom/separator",
    "tray",
  ],

  "custom/layout": {
    "exec": "/home/rekkord/.config/waybar/layout.sh",
    "interval": 1,
    "tooltip": false,
  },

  "custom/separator": {
    "format": " | ",
  },

  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "warp-on-scroll": false,
  },

  "tray": {
    "spacing": 10,
    "icon-size": 15,
  },

  "clock": {
    "format": "{:%I:%M %p}",
    "timezone": "Asia/Philippines",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#89b4fa'><b>{}</b></span>",
        "days": "<span color='#cdd6f4'><b>{}</b></span>",
        "weeks": "<span color='#f5e0dc'>W{}</span>",
        "weekdays": "<span color='#f2cdcd'><b>{}</b></span>",
        "today": "<span color='#f38ba8'><b><u>{}</u></b></span>",
      },
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
    },
  },

  "battery": {
    "format": "bat {capacity}%",
    "tooltip-format": "{timeTo}, Click to logout",
    "on-click": "swaynag -t warning -m 'Would you like to exit Sway?' -B 'exit' 'swaymsg exit'",
  },

  "network": {
    "format-wifi": "net wlan",
    "format-ethernet": "net eth",
    "format-disconnected": "net n/a",
  },

  "pulseaudio": {
    "format": "vol {volume}%",
    "format-muted": "vol n/a",
    "on-click": "kitty -e ~/pulsemixer",
  },
}
